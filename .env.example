# DeepStudent (Go) — Environment Variables
# Copy to .env and fill in the keys you want to enable.

# Data directory (default: ~/.deepstudent-go)
DEEPSTUDENT_DATA=

# Log level: debug | info | warn | error (default: info)
DEEPSTUDENT_LOG_LEVEL=info

# Privacy mode: true|false (default false)
DEEPSTUDENT_PRIVACY=false

# Active A/B slot: A | B (default A)
DEEPSTUDENT_SLOT=A

# HTTP API listen address (default 127.0.0.1:0 = disabled)
DEEPSTUDENT_HTTP=127.0.0.1:0

# LLM provider credentials (any subset is OK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
TONGYI_API_KEY=
MOONSHOT_API_KEY=
